{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "docs: dev server",
            "type": "shell",
            "command": "npm run dev",
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "problemMatcher": {
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "ready in|Local"
                }
            }
        }
    ]
}
