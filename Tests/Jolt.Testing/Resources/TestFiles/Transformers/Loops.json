{
  "#foreach(@x;@i in $.array) into 'Array'": [
    {
      "ArrayElementId": "@x.arrayElementId",
      "GlobalId": "#valueOf($.integerLiteral)",
      "Index": "@i"
    }
  ],
  "#foreach(@x in $.exampleBaseProperty) into 'Object'": {
    "#nameOf(@x)": "@x.value"
  },
  "#foreach(@x in $.exampleBaseProperty) into 'ArrayFromObject'": [
    {
      "#nameOf(@x)": "@x.value"
    }
  ],
  "#foreach(@x in $.array) into 'ObjectFromArray'": {
    "Result": "@x.arrayElementId"
  },
  "#foreach(@x in $.exampleBaseProperty) into 'RootObject'": {
    "#foreach(@y in @x.testArray) into @temp": [
        {
          "#nameOf(@x)": "@y.text",
          "#nameOf(@y)": "@x.value"
        }
      ],
      "#nameOf(@x)": "@temp"
  }
}