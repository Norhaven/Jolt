        },
        {
          "name": "EndsWith works with a range variable containing a string value and an invalid string end",
          "transformer": {
            "@x": "#valueOf($.spacedAndCasedStringValue)",
            "resultValue": "@x->#endsWith('asdf ')"
          },
          "result": {
            "resultValue": false
          }
        },
        {
          "name": "Replace works with a range variable containing a string value and a valid substring",
          "transformer": {
            "@x": "#valueOf($.spacedAndCasedStringValue)",
            "resultValue": "@x->#replace('tESt ', 'test')"
          },
          "result": {
            "resultValue": " tHIs iS a test"
          }
        },
        {
          "name": "Replace works with a range variable containing a string value and an invalid substring",
          "transformer": {
            "@x": "#valueOf($.spacedAndCasedStringValue)",
            "resultValue": "@x->#replace('asdf ', 'test')"
          },
          "result": {
            "resultValue": " tHIs iS a tESt "
          }
        },
        {
          "name": "IsRegexMatch is true with a range variable containing a string value and a pattern that is present",
          "transformer": {
            "@x": "#valueOf($.stringValue)",
            "resultValue": "#isRegexMatch(@x, 'is')"
          },
          "result": {
            "resultValue": true
          }
        },
        {
          "name": "IsRegexMatch is false with a range variable containing a string value and a pattern that is not present",
          "transformer": {
            "@x": "#valueOf($.stringValue)",
            "resultValue": "#isRegexMatch(@x, 'asdf')"
          },
          "result": {
            "resultValue": false
          }
        },
        {
          "name": "RegexReplace works with a range variable containing a string value and a pattern that is present",
          "transformer": {
            "@x": "#valueOf($.stringValue)",
            "resultValue": "#regexReplace(@x, 'is', 'x')"
          },
          "result": {
            "resultValue": "thx x a test"
          }
        },
        {
          "name": "RegexReplace works with a range variable containing a string value and a pattern that is not present",
          "transformer": {
            "@x": "#valueOf($.stringValue)",
            "resultValue": "#regexReplace(@x, 'asdf', 'x')"
          },
          "result": {
            "resultValue": "this is a test"
          }
        },
        {
          "name": "Reverse works with a range variable containing a string value",
          "transformer": {
            "@x": "#valueOf($.stringValue)",
            "resultValue": "#reverse(@x)"
          },
          "result": {
            "resultValue": "tset a si siht"
          }
        },
        {
          "name": "Reverse works with a range variable containing an array",
          "transformer": {
            "@x": "#valueOf($.stringArray)",
            "resultValue": "#reverse(@x)"
          },
          "result": {
            "resultValue": [ "test", "a", "is", "this" ]
          }
        },
        {
          "name": "Flatten works with a range variable containing a single-level array and returns a single-level array",
          "transformer": {
            "@x": "#valueOf($.stringArray)",
            "resultValue": "#flatten(@x)"
          },
          "result": {
            "resultValue": [ "this", "is", "a", "test" ]
          }
        },
        {
          "name": "Flatten works with a range variable containing a multi-level array and returns asingle-level array",
          "transformer": {
            "@x": "#valueOf($.nestedIntegerArray)",
            "resultValue": "#flatten(@x)"
          },
          "result": {
            "resultValue": [ 1, 2, 3, 4, 5 ]
          }
        }


      ]
    },
    {
      "name": "Standard library methods work with range variables in lambda expressions",
      "source": {
        "integerValue": 1,
        "doubleValue": 3.1415,
        "stringValue": "3",
        "booleanValue": true,
        "booleanStringValue": "true",
        "stringText": "this is a test",
        "stringArray": [ "this", "is", "a", "test" ],
        "integerArray": [ 0, 5, 1, 9 ],
        "emptyArray": [],
        "testObject": {
          "first": "value",
          "second": 2,
          "third": [ 1, 2, 3 ]
        }
      },
      "tests": [
        {
          "name": "IndexOf works with a range variable containing a string value",
          "transformer": {
            "resultArray": "#valueOf($.stringArray)->#select(@x: #indexOf(@x, 'is'))"
          },
          "result": {
            "resultArray": [ 2, 0, -1, -1 ]
          }
        },
        {
          "name": "Length works with a range variable containing a string value",
          "transformer": {
            "resultArray": "#valueOf($.stringArray)->#select(@x: #length(@x))"
          },
          "result": {
            "resultArray": [ 4, 2, 1, 4 ]
          }
        },
        {
          "name": "If/Substring works with a range variable containing a string value",
          "transformer": {
            "resultArray": "#valueOf($.stringArray)->#select(@x: #if(#length(@x) > 2, #substring(@x, ..2), 0))"
          },
          "result": {
            "resultArray": [ "th", 0, 0, "te" ]
          }
        },
        {
          "name": "GroupBy works with a range variable containing a string value",
          "transformer": {
            "@x": "#valueOf($.stringArray)",
            "resultArray": "#groupBy(@x, @y: #contains(@y, 'is')))"
          },
          "result": {
            "resultArray": [
              {
                "key": true,
                "results": [ "this", "is" ]
              },
              {
                "key": false,
                "results": [ "a", "test" ]
              }
            ]
          }
        },
        {
          "name": "OrderBy works with a range variable containing an integer array",
          "transformer": {
            "@x": "#valueOf($.integerArray)",
            "resultArray": "#orderBy(@x)"
          },
          "result": {
            "resultArray": [ 0, 1, 5, 9 ]
          }
        },
        {
          "name": "OrderByDesc works with a range variable containing an integer array",
          "transformer": {
            "@x": "#valueOf($.integerArray)",
            "resultArray": "#orderByDesc(@x)"
          },
          "result": {
            "resultArray": [ 9, 5, 1, 0 ]
          }
        },
        {
          "name": "RoundTo works with a range variable containing a double value",
          "transformer": {
            "@x": "#valueOf($.doubleValue)",
            "resultValue": "#roundTo(@x, 2)"
          },
          "result": {
            "resultValue": 3.14
          }
        },
        {
          "name": "Max works with a range variable containing an integer array",
          "transformer": {
            "@x": "#valueOf($.integerArray)",
            "resultValue": "#max(@x)"
          },
          "result": {
            "resultValue": 9
          }
        },
        {
          "name": "Min works with a range variable containing an integer array",
          "transformer": {
            "@x": "#valueOf($.integerArray)",
            "resultValue": "#min(@x)"
          },
          "result": {
            "resultValue": 0
          }
        },
        {
          "name": "Sum works with a range variable containing an integer array",
          "transformer": {
            "@x": "#valueOf($.integerArray)",
            "resultValue": "#sum(@x)"
          },
          "result": {
            "resultValue": 15
          }
        },
        {
          "name": "Average works with a range variable containing an integer array",
          "transformer": {
            "@x": "#valueOf($.integerArray)",
            "resultValue": "#average(@x)"
          },
          "result": {
            "resultValue": 3.75
          }
        },
        {
          "name": "JoinWith works with a range variable containing a string array",
          "transformer": {
            "@x": "#valueOf($.stringArray)",
            "resultValue": "#joinWith(@x, ',')"
          },
          "result": {
            "resultValue": "this,is,a,test"
          }
        },
        {
          "name": "SplitOn works with a range variable containing a string value",
          "transformer": {
            "@x": "#valueOf($.stringText)",
            "resultArray": "#splitOn(@x, ' ')"
          },
          "result": {
            "resultArray": [ "this", "is", "a", "test" ]
          }
        },
        {
          "name": "Append works with a range variable containing a string value",
          "transformer": {
            "@x": "#valueOf($.stringText)",
            "resultValue": "#append(@x, ' ', '1', '2', '3')"
          },
          "result": {
            "resultValue": "this is a test 123"
          }
        },
        {
          "name": "Append works with a range variable containing a string array",
          "transformer": {
            "@x": "#valueOf($.stringArray)",
            "resultArray": "#append(@x, ' ', '1', '2', '3')"
          },
          "result": {
            "resultArray": [ "this", "is", "a", "test", " ", "1", "2", "3" ]
          }
        },
        {
          "name": "IsInteger works with a range variable containing an integer value",
          "transformer": {
            "@x": "#valueOf($.integerValue)",
            "resultValue": "#isInteger(@x)"
          },
          "result": {
            "resultValue": true
          }
        },
        {
          "name": "IsDecimal works with a range variable containing a double value",
          "transformer": {
            "@x": "#valueOf($.doubleValue)",
            "resultValue": "#isDecimal(@x)"
          },
          "result": {
            "resultValue": true
          }
        },
        {
          "name": "IsBoolean works with a range variable containing a boolean value",
          "transformer": {
            "@x": "#valueOf($.booleanValue)",
            "resultValue": "#isBoolean(@x)"
          },
          "result": {
            "resultValue": true
          }
        },
        {
          "name": "IsString works with a range variable containing a string value",
          "transformer": {
            "@x": "#valueOf($.stringText)",
            "resultValue": "#isString(@x)"
          },
          "result": {
            "resultValue": true
          }
        },
        {
          "name": "IsEmpty works with a range variable containing a string value",
          "transformer": {
            "@x": "''",
            "resultValue": "#isEmpty(@x)"
          },
          "result": {
            "resultValue": true
          }
        },
        {
          "name": "IsEmpty works with a range variable containing an array value",
          "transformer": {
            "@x": "#valueOf($.emptyArray)",
            "resultValue": "#isEmpty(@x)"
          },
          "result": {
            "resultValue": true
          }
        },
        {
          "name": "Any works with a range variable containing an array value",
          "transformer": {
            "@x": "#valueOf($.stringArray)",
            "resultValue": "#any(@x)"
          },
          "result": {
            "resultValue": true
          }
        },
        {
          "name": "Where works with a range variable containing an array value",
          "transformer": {
            "@x": "#valueOf($.integerArray)",
            "resultArray": "#where(@x, @y: @y > 4)"
          },
          "result": {
            "resultArray": [ 5, 9 ]
          }
        },
        {
          "name": "Select works with a range variable containing an array value",
          "transformer": {
            "@x": "#valueOf($.integerArray)",
            "resultArray": "#select(@x, @y: @y * 2)"
          },
          "result": {
            "resultArray": [ 0, 10, 2, 18 ]
          }
        },
        {
          "name": "ToInteger works with a range variable containing a string value",
          "transformer": {
            "@x": "#valueOf($.stringValue)",
            "resultValue": "#toInteger(@x)"
          },
          "result": {
            "resultValue": 3
          }
        },
        {
          "name": "ToString works with a range variable containing an integer value",
          "transformer": {
            "@x": "#valueOf($.integerValue)",
            "resultValue": "#toString(@x)"
          },
          "result": {
            "resultValue": "1"
          }
        },
        {
          "name": "ToDecimal works with a range variable containing a string value",
          "transformer": {
            "@x": "#valueOf($.stringValue)",
            "resultValue": "#toDecimal(@x)"
          },
          "result": {
            "resultValue": 3.0
          }
        },
        {
          "name": "ToBoolean works with a range variable containing a string value",
          "transformer": {
            "@x": "#valueOf($.booleanStringValue)",
            "resultValue": "#toBoolean(@x)"
          },
          "result": {
            "resultValue": true
          }
        },
        {
          "name": "SummarizeWith works with a range variable containing a string array",
          "transformer": {
            "@x": "#valueOf($.stringArray)->#groupBy(@y: #contains(@y, 'is'))",
            "resultArray": "#summarizeWith(@x, @group: #length(@group.results))"
          },
          "result": {
            "resultArray": [
              {
                "true": 2
              },
              {
                "false": 2
              }
            ]
          }
        },
        {
          "name": "#when method works with #setAt/#removeAt when condition is true",
          "transformer": {
            "#using($.testObject as @x) into 'resultObject'": [
              "#when(#valueOf($.booleanValue), #setAt(@x.addedProperty, 'new value'))",
              "#when(#valueOf($.integerValue) == 1, #removeAt(@x.first))"
            ]
          },
          "result": {
            "resultObject": {
              "second": 2,
              "third": [ 1, 2, 3 ],
              "addedProperty": "new value"
            }
          }
        },
        {
          "name": "#when method works with #setAt/#removeAt when condition is false",
          "transformer": {
            "#using($.testObject as @x) into 'resultObject'": [
              "#when(!#valueOf($.booleanValue), #setAt(@x.addedProperty, 'new value'))",
              "#when(#valueOf($.integerValue) == 2, #removeAt(@x.first))"
            ]
          },
          "result": {
            "resultObject": {
              "first": "value",
              "second": 2,
              "third": [ 1, 2, 3 ]
            }
          }
        },
        {
          "name": "#when method fails with non-statement method call error when condition is true",
          "transformer": {
            "#using($.testObject as @x) into 'resultObject'": [
              "#when(#valueOf($.booleanValue), #valueOf($.integerValue))"
            ]
          },
          "exceptionCode": "externalMethodException",
          "rootExceptionCode": "usedNonStatementMethodInWhen"
        },
        {
          "name": "#when method works with #setAt/#removeAt when condition is true",
          "transformer": {
            "#using($.testObject as @x) into 'resultObject'": [
              "#when(#valueOf($.booleanValue), #setAt(@x.addedProperty, 'new value'))",
              "#when(#valueOf($.integerValue) == 1, #removeAt(@x.first))"
            ]
          },
          "result": {
            "resultObject": {
              "second": 2,
              "third": [ 1, 2, 3 ],
              "addedProperty": "new value"
            }
          }
        },
        {
          "name": "#when method works with multiple statements",
          "transformer": {
            "#using($.testObject as @x) into 'resultObject'": [
              "#when(#valueOf($.booleanValue), #setAt(@x.addedProperty, 'new value'), #removeAt(@x.first))"
            ]
          },
          "result": {
            "resultObject": {
              "second": 2,
              "third": [ 1, 2, 3 ],
              "addedProperty": "new value"
            }
          }
        },
        {
          "name": "SetAt/RemoveAt works with a range variable containing a root object",
          "transformer": {
            "#using($ as @x) into 'newObject'": [
              "#setAt(@x.addedProperty, 'new value')",
              "#removeAt(@x.testObject.first)"
            ]
          },
          "result": {
            "newObject": {
              "integerValue": 1,
              "doubleValue": 3.1415,
              "stringValue": "3",
              "booleanValue": true,
              "booleanStringValue": "true",
              "stringText": "this is a test",
              "stringArray": [ "this", "is", "a", "test" ],
              "integerArray": [ 0, 5, 1, 9 ],
              "emptyArray": [],
              "testObject": {
                "second": 2,
                "third": [ 1, 2, 3 ]
              },
              "addedProperty": "new value"
            }
          }
        }
      ]
    },
    {
      "name": "Standard library methods will accept a piped method call off of a range variable",
      "source": {
        "stringArray": [ "this", "is", "a", "test" ]
      },
      "tests": [
        {
          "name": "Length works with a piped method call off of a range variable containing a string value",
          "transformer": {
            "resultArray": "#valueOf($.stringArray)->#select(@x: @x->#length())"
          },
          "result": {
            "resultArray": [ 4, 2, 1, 4 ]
          }
        },
        {
          "name": "Select works with a piped method call off of a range variable containing a string array",
          "transformer": {
            "@x": "#valueOf($.stringArray)",
            "resultArray": "@x->#select(@y: @y->#length())"
          },
          "result": {
            "resultArray": [ 4, 2, 1, 4 ]
          }
        }
      ]
    },
    {
      "name": "Standard library date/time methods work with range variables",
      "source": {
        "isoDateString": "2024-01-15T10:30:00",
        "isoDateWithZ": "2024-01-15T10:30:00Z",
        "customFormattedDate": "01/15/2024"
      },
      "tests": [
        {
          "name": "ParseDateTime works with ISO 8601 format string",
          "transformer": {
            "@x": "#valueOf($.isoDateString)",
            "resultValue": "#parseDateTime(@x, 'yyyy-MM-ddTHH:mm:ss')"
          },
          "result": {
            "resultValue": "2024-01-15T10:30:00.0000000"
          }
        },
        {
          "name": "ParseDateTime works with custom date format",
          "transformer": {
            "@x": "#valueOf($.customFormattedDate)",
            "resultValue": "#parseDateTime(@x, 'MM/dd/yyyy')"
          },
          "result": {
            "resultValue": "2024-01-15T00:00:00.0000000"
          }
        },
        {
          "name": "FormatDateTime works to convert ISO 8601 to custom format",
          "transformer": {
            "@x": "#valueOf($.isoDateString)",
            "resultValue": "#formatDateTime(@x, 'MMM dd, yyyy')"
          },
          "result": {
            "resultValue": "Jan 15, 2024"
          }
        },
        {
          "name": "FormatDateTime works to convert ISO 8601 to another format",
          "transformer": {
            "@x": "#valueOf($.isoDateString)",
            "resultValue": "#formatDateTime(@x, 'yyyy-MM-dd HH:mm:ss')"
          },
          "result": {
            "resultValue": "2024-01-15 10:30:00"
          }
        },
        {
          "name": "CurrentDateTime returns a non-null ISO 8601 formatted string",
          "transformer": {
            "@x": "#currentDateTime()",
            "resultHasValue": "#exists(@x)"
          },
          "result": {
            "resultHasValue": true
          }
        },
        {
          "name": "CurrentDateTimeUtc returns a non-null ISO 8601 formatted string",
          "transformer": {
            "@x": "#currentDateTimeUtc()",
            "resultHasValue": "#exists(@x)"
          },
          "result": {
            "resultHasValue": true
          }
        },
        {
          "name": "AddDays works with positive day value",
          "transformer": {
            "@x": "#valueOf($.isoDateString)",
            "resultValue": "#addDays(@x, 7)"
          },
          "result": {
            "resultValue": "2024-01-22T10:30:00.0000000"
          }
        },
        {
          "name": "AddDays works with negative day value",
          "transformer": {
            "@x": "#valueOf($.isoDateString)",
            "resultValue": "#addDays(@x, -5)"
          },
          "result": {
            "resultValue": "2024-01-10T10:30:00.0000000"
          }
        },
        {
          "name": "AddDays works with range variable containing numeric value",
          "transformer": {
            "@date": "#valueOf($.isoDateString)",
            "@days": 10,
            "resultValue": "#addDays(@date, @days)"
          },
          "result": {
            "resultValue": "2024-01-25T10:30:00.0000000"
          }
        },
        {
          "name": "AddHours works with positive hour value",
