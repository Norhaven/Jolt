{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "possibleExceptionCodes": {
  },
  "testGroups": [
    {
      "name": "Indexing works with range variables",
      "source": {
        "integerValue": 1,
        "doubleValue": 3.1415,
        "stringValue": "3",
        "booleanValue": true,
        "booleanStringValue": "true",
        "stringText": "this is a test",
        "stringArray": [ "this", "is", "a", "test" ],
        "integerArray": [ 0, 5, 1, 9 ],
        "emptyArray": [],
        "testObject": {
          "first": "value",
          "second": 2,
          "third": [ 1, 2, 3 ]
        },
        "text": "this is an example",
        "numbers": [ 1, 9, 3, 2, 6 ]
      },
      "tests": [
        {
          "name": "Indexer into a range variable containing a string value works",
          "transformer": {
            "@x": "#valueOf($.stringText)",
            "resultString": "@x[0]"
          },
          "result": {
            "resultString": "t"
          }
        },
        {
          "name": "Indexer from the end into a range variable containing a string value works",
          "transformer": {
            "@x": "#valueOf($.stringText)",
            "resultString": "@x[^2]"
          },
          "result": {
            "resultString": "s"
          }
        },
        {
          "name": "Indexer slice into a range variable containing a string value creates substring",
          "transformer": {
            "@x": "#valueOf($.stringText)",
            "resultString": "@x[..2]"
          },
          "result": {
            "resultString": "th"
          }
        },
        {
          "name": "Indexer slice into a range variable containing a string array creates slice",
          "transformer": {
            "@x": "#valueOf($.stringArray)",
            "resultArray": "@x[..2]"
          },
          "result": {
            "resultArray": [ "this", "is" ]
          }
        },
        {
          "name": "Indexer slice into a range variable containing an integer array creates slice",
          "transformer": {
            "@x": "#valueOf($.integerArray)",
            "resultArray": "@x[1..3]"
          },
          "result": {
            "resultArray": [ 5, 1 ]
          }
        },
        {
          "name": "Indexer slice into the middle to the end of a range variable containing an integer array creates slice",
          "transformer": {
            "@x": "#valueOf($.integerArray)",
            "resultArray": "@x[2..]"
          },
          "result": {
            "resultArray": [ 1, 9 ]
          }
        },
        {
          "name": "Indexer slice into the middle to end offset of a range variable containing an integer array creates slice",
          "transformer": {
            "@x": "#valueOf($.integerArray)",
            "resultArray": "@x[1..^1]"
          },
          "result": {
            "resultArray": [ 5, 1 ]
          }
        },
        {
          "name": "Indexer substring and slice all work as expected",
          "transformer": {
            "@someText": "#valueOf($.text)",
            "@someNumbers": "#valueOf($.numbers)",
            "textStart": "@someText[..2]",
            "textMiddle": "@someText[1..3]",
            "textEnd": "@someText[^2..]",
            "textCharacter": "@someText[^1]",
            "arrayStart": "@someNumbers[..3]",
            "arrayMiddle": "@someNumbers[2..4]",
            "arrayEnd": "@someNumbers[^3..]",
            "arrayElement": "@someNumbers[1]"
          },
          "result": {
            "textStart": "th",
            "textMiddle": "hi",
            "textEnd": "le",
            "textCharacter": "e",
            "arrayStart": [ 1, 9, 3 ],
            "arrayMiddle": [ 3, 2 ],
            "arrayEnd": [ 3, 2, 6 ],
            "arrayElement": [ 9 ]
          }
        }
      ]
    },
    {
      "name": "Indexing works with method return values",
      "source": {
        "text": "this is an example",
        "numbers": [ 1, 9, 3, 2, 6 ],
        "singleNumberTwo": 2,
        "singleNumberThree": 3
      },
      "tests": [
        {
          "name": "Indexer substring and slice both work as expected with range dots at the beginning",
          "transformer": {
            "textSubstring": "#valueOf($.text)[..2]",
            "arraySlice": "#valueOf($.numbers)[..3]"
          },
          "result": {
            "textSubstring": "th",
            "arraySlice": [ 1, 9, 3 ]
          }
        },
        {
          "name": "Indexer substring and slice both work as expected with range dots at the end",
          "transformer": {
            "textSubstring": "#valueOf($.text)[2..]",
            "arraySlice": "#valueOf($.numbers)[2..]"
          },
          "result": {
            "textSubstring": "is is an example",
            "arraySlice": [ 3, 2, 6 ]
          }
        },
        {
          "name": "Indexer substring and slice both work as expected with range dots in the middle and no end caret",
          "transformer": {
            "textSubstring": "#valueOf($.text)[1..3]",
            "arraySlice": "#valueOf($.numbers)[1..3]"
          },
          "result": {
            "textSubstring": "hi",
            "arraySlice": [ 9, 3 ]
          }
        },
        {
          "name": "Indexer substring and slice both work as expected with range dots in the middle and an end caret at the last index",
          "transformer": {
            "textSubstring": "#valueOf($.text)[1..^3]",
            "arraySlice": "#valueOf($.numbers)[1..^3]"
          },
          "result": {
            "textSubstring": "his is an exam",
            "arraySlice": [ 9 ]
          }
        },
        {
          "name": "Indexer substring and slice both work as expected with range dots in the middle and an end caret at the first and last index",
          "transformer": {
            "textSubstring": "#valueOf($.text)[^3..^1]",
            "arraySlice": "#valueOf($.numbers)[^3..^1]"
          },
          "result": {
            "textSubstring": "pl",
            "arraySlice": [ 3, 2 ]
          }
        },
        {
          "name": "Indexer substring and slice both work as expected with range dots at the end and an end caret at the first index",
          "transformer": {
            "textSubstring": "#valueOf($.text)[^3..]",
            "arraySlice": "#valueOf($.numbers)[^3..]"
          },
          "result": {
            "textSubstring": "ple",
            "arraySlice": [ 3, 2, 6 ]
          }
        },
        {
          "name": "Indexer substring and slice both pass their results into subsequent piped methods as expected",
          "transformer": {
            "textSubstring": "#valueOf($.text)[..2]->#substring(^1)",
            "arraySlice": "#valueOf($.numbers)[..3]->#where(@x: @x >= 3)"
          },
          "result": {
            "textSubstring": "h",
            "arraySlice": [ 9, 3 ]
          }
        },
        {
          "name": "Indexer substring using variables works as expected",
          "transformer": {
            "@numberTwo": "#valueOf($.singleNumberTwo)",
            "@numberThree": "#valueOf($.singleNumberThree)",
            "textSubstring": "#valueOf($.text)[..@numberTwo]->#substring(^1)",
            "arraySlice": "#valueOf($.numbers)[..@numberThree]->#where(@x: @x >= 3)"
          },
          "result": {
            "textSubstring": "h",
            "arraySlice": [ 9, 3 ]
          }
        },
        {
          "name": "Indexer substring and slice both work as expected with range dots at the end and variable at the first index",
          "transformer": {
            "@numberThree": "#valueOf($.singleNumberThree)",
            "textSubstring": "#valueOf($.text)[^@numberThree..]",
            "arraySlice": "#valueOf($.numbers)[^@numberThree..]"
          },
          "result": {
            "textSubstring": "ple",
            "arraySlice": [ 3, 2, 6 ]
          }
        },
        {
          "name": "Indexer substring and slice both work as expected with range dots at the end and method call at the first index",
          "transformer": {
            "textSubstring": "#valueOf($.text)[^#valueOf($.singleNumberThree)..]",
            "arraySlice": "#valueOf($.numbers)[^#valueOf($.singleNumberThree)..]"
          },
          "result": {
            "textSubstring": "ple",
            "arraySlice": [ 3, 2, 6 ]
          }
        }
      ]
    }
  ]
}