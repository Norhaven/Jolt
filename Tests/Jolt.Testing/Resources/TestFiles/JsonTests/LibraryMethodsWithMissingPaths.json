    {
      "name": "A null-safe dereference gives null when the value before it is null or missing, which standard library methods treat as any other null",
      "source": {
        "testObject": {
          "first": "value",
          "second": 2,
          "nullValue": null
        }
      },
      "tests": [
        {
          "name": "A null-safe dereference of a null variable gives null without dereferencing the rest of the chain",
          "transformer": {
            "@x": null,
            "resultValue": "@x?.first.second"
          },
          "result": {
            "resultValue": null
          }
        },
        {
          "name": "A null-safe dereference of a property that does not exist or is null gives null without dereferencing the rest of the chain",
          "transformer": {
            "@x": "#valueOf($.testObject)",
            "missingValue": "@x.nonExistentValue?.deeper.deepest",
            "nullValue": "@x.nullValue?.deeper.deepest"
          },
          "result": {
            "missingValue": null,
            "nullValue": null
          }
        },
        {
          "name": "A null-safe dereference of a present value dereferences the property after it as usual",
          "transformer": {
            "@x": "#valueOf($.testObject)",
            "presentValue": "@x?.first",
            "missingValue": "@x?.nonExistentValue"
          },
          "result": {
            "presentValue": "value",
            "missingValue": null
          }
        },
        {
          "name": "A null-safe dereference only guards the value before it",
          "transformer": {
            "@x": "#valueOf($.testObject)",
            "resultValue": "@x?.nonExistentValue.deeper"
          },
          "exceptionCode": "dereferencedMissingProperty"
        },
