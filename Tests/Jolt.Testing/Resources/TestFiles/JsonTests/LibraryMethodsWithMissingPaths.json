          "result": {
            "resultValue": []
          }
        },
        {
          "name": "Merge returns the other object for a null-safe dereference that does not exist",
          "transformer": {
            "@x": "#valueOf($.testObject)",
            "resultValue": "#merge(@x?.nonExistentValue, $.testObject)"
          },
          "result": {
            "resultValue": {
              "first": "value",
              "second": 2
            }
          }
        },
        {
          "name": "Null-coalescing provides a default for a library call on a null-safe dereference that does not exist",
          "transformer": {
            "@x": "#valueOf($.testObject)",
            "resultValue": "#toUpperCase(@x?.nonExistentValue) ?? 'n/a'"
          },
          "result": {
            "resultValue": "n/a"
          }
        },
        {
          "name": "Nested null-safe dereference returns null when an intermediate property does not exist",
          "transformer": {
            "@x": "#valueOf($.testObject)",
            "resultValue": "#length(@x.nonExistentValue?.deeper)"
          },
          "result": {
            "resultValue": null
          }
        }
      ]
    },
    {
      "name": "Errors from library calls on null values and missing paths can be handled with #try",
      "source": {
        "testObject": {
          "first": "value",
          "second": 2
        }
      },
      "tests": [
        {
          "name": "Try error handler receives the missing path error code",
          "transformer": {
            "resultValue": "#try(#length($.nonExistentValue), @e: @e.code)"
          },
          "result": {
            "resultValue": "JLT563"
          }
        },
        {
          "name": "Try error handler receives the null value error code",
          "transformer": {
            "@x": null,
            "resultValue": "#try(#length(@x), @e: @e.code)"
          },
          "result": {
            "resultValue": "JLT574"
          }
        },
        {
          "name": "Try error handler receives the missing path error message",
          "transformer": {
            "resultValue": "#try(#length($.nonExistentValue), @e: @e.message)"
          },
          "result": {
            "resultValue": "Unable to perform library call using missing path '$.nonExistentValue'"
          }
        },
        {
          "name": "Try error handler can choose a fallback based on the error code",
          "transformer": {
            "resultValue": "#try(#toUpperCase($.nonExistentValue), @e: #if(@e.code == 'JLT563', 'missing', 'other'))"
          },
          "result": {
            "resultValue": "missing"
          }
        }
      ]
    }
  ]
}
