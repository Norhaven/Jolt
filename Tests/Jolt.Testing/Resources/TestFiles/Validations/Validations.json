{
  "validations": [
    {
      "name": "A match case with an object pattern will capture its variables for the rest of the condition and the case value",
      "transformer": {
        "#match($.singlePropertyObject as @x) into 'resultValue'": [
          { "#is({ 'first': @f }) && #given(#isString(@f))": "#append('this is an object ', @f)" },
          { "#default()": "'defaultValue'" }
        ]
      },
      "expectedIssues": []
    },
    {
      "name": "A match case with an array pattern will capture its variables for the case value",
      "transformer": {
        "#match($.multipleElementArray as @x) into 'resultValue'": [
          { "#is([@f, 'is', 'a', @y])": "#append('this is an array ', @f, ' ', @y)" },
          { "#default()": "'defaultValue'" }
        ]
      },
      "expectedIssues": []
    },
    {
      "name": "A match case with a nested pattern will capture its nested variables",
      "transformer": {
        "#match($.value as @x) into 'resultValue'": [
          { "#is({ 'first': [@a, { 'second': @b }] })": "#append(@a, @b, @x)" }
        ]
      },
      "expectedIssues": []
    },
    {
      "name": "Variables captured by one match case are not available to other match cases",
      "transformer": {
        "#match($.value as @x) into 'resultValue'": [
          { "#is([@f])": "@f" },
          { "#given(#isString(@f))": "@f" }
        ]
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable",
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "A match case condition using a variable before the pattern that captures it will fail",
      "transformer": {
        "#match($.value as @x) into 'resultValue'": [
          { "#given(#isString(@f)) && #is([@f])": "@f" }
        ]
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "An undeclared variable within an object literal will fail",
      "transformer": {
        "r": "#toString({ 'a': @nope })"
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "A JSON path with a hyphenated name in brackets will succeed",
      "transformer": {
        "r": "#valueOf($['with-hyphen'])"
      },
      "expectedIssues": []
    },
    {
      "name": "An indexed variable with an undeclared variable as its index will fail once",
      "transformer": {
        "@l": [
          1
        ],
        "r": "@l[@nope]"
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "A range with an undeclared variable at each end will fail for each",
      "transformer": {
        "@l": [
          1
        ],
        "r": "@l[@nope..@nope2]"
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable",
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "An indexed and dereferenced variable will succeed",
      "transformer": {
        "@l": [
          {
            "x": 1
          }
        ],
        "r": "@l[0].x"
      },
      "expectedIssues": []
    },
    {
      "name": "An indexed and dereferenced variable with an undeclared variable as its index will fail",
      "transformer": {
        "@l": [
          {
            "x": 1
          }
        ],
        "r": "@l[@nope].x"
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "A statement path that indexes the variable will fail",
      "transformer": {
        "#using($.o as @x) into 'r'": [
          "#setAt(@x[0].n, 1)"
        ]
      },
      "expectedIssues": [
        "UnableToUseStatementPathThatIsNotDereferenceOfUsingVariable"
      ]
    },
    {
      "name": "An indexed property will succeed",
      "transformer": {
        "@g": {
          "kids": [
            1
          ]
        },
        "r": "@g.kids[0]"
      },
      "expectedIssues": []
    },
    {
      "name": "An indexed property with an undeclared variable as its index will fail",
      "transformer": {
        "@g": {
          "kids": [
            1
          ]
        },
        "r": "@g.kids[@nope]"
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "An indexed statement path will fail",
      "transformer": {
        "#using($.o as @x) into 'r'": [
          "#setAt(@x.list[0], 1)"
        ]
      },
      "expectedIssues": [
        "UnableToUseStatementPathThatIsNotDereferenceOfUsingVariable"
      ]
    },
    {
      "name": "A JSON path with a hyphenated name will fail",
      "transformer": {
        "r": "#valueOf($.with-hyphen)"
      },
      "expectedIssues": [
        "UnableToUseJsonPathNameWithoutBracketNotation"
      ]
    },
    {
      "name": "A JSON path with an RFC 9535 filter will succeed",
      "transformer": {
        "r": "#valueOf($.items[?@.price > 15])"
      },
      "expectedIssues": []
    },
    {
      "name": "A JSON path with a hyphenated name in a filter will fail",
      "transformer": {
        "r": "#valueOf($.items[?(@.with-hyphen)])"
      },
      "expectedIssues": [
        "UnableToParseJsonPath"
      ]
    },
    {
      "name": "A variable with no spaces around an operator will succeed",
      "transformer": {
        "r": "#select($.a,@v:@v+$.b)"
      },
      "expectedIssues": []
    },
    {
      "name": "A variable name starting with a digit will fail",
      "transformer": {
        "r": "#select($.a,@1v:1)"
      },
      "expectedIssues": [
        "UnableToParseVariableName"
      ]
    },
    {
      "name": "A valid JSON path will succeed",
      "transformer": {
        "r": "#valueOf($.a.b)"
      },
      "expectedIssues": []
    },
    {
      "name": "A JSON path with a filter and spaces will succeed",
      "transformer": {
        "r": "#valueOf($.items[?(@.price > 15)])"
      },
      "expectedIssues": []
    },
    {
      "name": "A JSON path with a bracketed name containing a comma will succeed",
      "transformer": {
        "r": "#valueOf($['with,comma'])"
      },
      "expectedIssues": []
    },
    {
      "name": "A JSON path in an array literal with no spaces will succeed",
      "transformer": {
        "r": "[$.b,$.s]"
      },
      "expectedIssues": []
    },
    {
      "name": "A JSON path ending in a dot will fail",
      "transformer": {
        "r": "#valueOf($.)"
      },
      "expectedIssues": [
        "UnableToParseJsonPath"
      ]
    },
    {
      "name": "A JSON path with an unclosed bracket will fail",
      "transformer": {
        "r": "#length($.a[)"
      },
      "expectedIssues": [
        "UnableToParseJsonPath"
      ]
    },
    {
      "name": "A JSON path as the source of a loop will fail if it's invalid",
      "transformer": {
        "#foreach(@i in $.) into 'r'": [
          {
            "v": 1
          }
        ]
      },
      "expectedIssues": [
        "UnableToParseJsonPath"
      ]
    },
    {
      "name": "A JSON path as the source of a using block will fail if it's invalid",
      "transformer": {
        "#using($. as @x) into 'r'": [
          "#removeAt(@x.a)"
        ]
      },
      "expectedIssues": [
        "UnableToParseJsonPath",
        "UnableToUseMethodOutsideOfStatementBlock",
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "A JSON path in a using statement will fail if it's invalid",
      "transformer": {
        "#using($.o as @x) into 'r'": [
          "#setAt(@x.a, #valueOf($.))"
        ]
      },
      "expectedIssues": [
        "UnableToParseJsonPath"
      ]
    },
    {
      "name": "Null literal inside of an array will succeed",
      "transformer": {
        "a": [
          null
        ]
      },
      "expectedIssues": []
    },
    {
      "name": "Null literals among other nested array elements will succeed",
      "transformer": {
        "a": [
          1,
          null,
          {
            "b": [
              null
            ]
          }
        ]
      },
      "expectedIssues": []
    },
    {
      "name": "Null literal inside of a using block array will fail",
      "transformer": {
        "#using($.a as @x) into 'r'": [
          null
        ]
      },
      "expectedIssues": [
        "UnableToUseNonStatementExpressionWithinStatementBlock"
      ]
    },
    {
      "name": "Variable declaration with literal will succeed",
      "transformer": {
        "@x": "1"
      },
      "expectedIssues": []
    },
    {
      "name": "Method call in property value will succeed",
      "transformer": {
        "result": "#valueOf($.path)"
      },
      "expectedIssues": []
    },
    {
      "name": "Variable declared before sibling use will succeed",
      "transformer": {
        "@x": "#valueOf($.path)",
        "result": "@x"
      },
      "expectedIssues": []
    },
    {
      "name": "Foreach loop with valid loop variable in template will succeed",
      "transformer": {
        "#foreach(@x in $.someArray) into 'result'": [
          {
            "value": "@x.field"
          }
        ]
      },
      "expectedIssues": []
    },
    {
      "name": "Foreach loop output to generated variable used by sibling will succeed",
