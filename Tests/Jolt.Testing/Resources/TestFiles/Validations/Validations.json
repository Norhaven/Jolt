{
  "validations": [
    {
      "name": "Variable declaration with literal will succeed",
      "transformer": {
        "@x": "1"
      },
      "expectedIssues": []
    },
    {
      "name": "Method call in property value will succeed",
      "transformer": {
        "result": "#valueOf($.path)"
      },
      "expectedIssues": []
    },
    {
      "name": "Variable declared before sibling use will succeed",
      "transformer": {
        "@x": "#valueOf($.path)",
        "result": "@x"
      },
      "expectedIssues": []
    },
    {
      "name": "Foreach loop with valid loop variable in template will succeed",
      "transformer": {
        "#foreach(@x in $.someArray) into 'result'": [
          {
            "value": "@x.field"
          }
        ]
      },
      "expectedIssues": []
    },
    {
      "name": "Foreach loop output to generated variable used by sibling will succeed",
      "transformer": {
        "#foreach(@x in $.someArray) into @temp": [
          {
            "value": "@x.field"
          }
        ],
        "result": "@temp"
      },
      "expectedIssues": []
    },
    {
      "name": "Using block with path alias will succeed",
      "transformer": {
        "#using($.someObject as @x) into 'result'": [
          "#setAt(@x.field, 5)"
        ]
      },
      "expectedIssues": []
    },
    {
      "name": "Using block with declared variable alias will succeed",
      "transformer": {
        "@src": "#valueOf($.someObject)",
        "#using(@src as @x) into 'result'": [
          "#removeAt(@x.oldField)"
        ]
      },
      "expectedIssues": []
    },
    {
      "name": "Lambda expression with valid lambda variable will succeed",
      "transformer": {
        "result": "#valueOf($.someArray)->#any(@x: @x > 5)"
      },
      "expectedIssues": []
    },
    {
      "name": "Conditional if expression will succeed",
      "transformer": {
        "result": "#if(#exists($.someValue), 'yes', 'no')"
      },
      "expectedIssues": []
    },
    {
      "name": "Piped method calls will succeed",
      "transformer": {
        "result": "#valueOf($.path)->#exists()"
      },
      "expectedIssues": []
    },
    {
      "name": "Nested object with valid method call will succeed",
      "transformer": {
        "outer": {
          "inner": "#valueOf($.path)"
        }
      },
      "expectedIssues": []
    },
    {
      "name": "Binary expression with paths and literals will succeed",
      "transformer": {
        "result": "#valueOf($.first) + #valueOf($.second)"
      },
      "expectedIssues": []
    },
    {
      "name": "Null coalescing expression will succeed",
      "transformer": {
        "result": "#valueOf($.nullable) ?? 'default'"
      },
      "expectedIssues": []
    },
    {
      "name": "Issue: Variable usage before declaration",
      "transformer": {
        "@x": "@y",
        "@y": "1"
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "Issue: Undeclared standalone variable reference fails",
      "transformer": {
        "result": "@x"
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "Issue: Undeclared variable property dereference fails",
      "transformer": {
        "result": "@x.field"
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "Issue: Sliced access of undeclared variable fails",
      "transformer": {
        "result": "@x[0..2]"
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "Issue: Undeclared variable used in foreach template fails",
      "transformer": {
        "#foreach(@x in $.someArray) into 'result'": [
          {
            "value": "@y.field"
          }
        ]
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "Issue: Undeclared variable used in using block statement fails",
      "transformer": {
        "#using($.someObject as @x) into 'result'": [
          "#removeAt(@y.field)"
        ]
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "Issue: Undeclared variable in lambda body fails",
      "transformer": {
        "result": "#valueOf($.someArray)->#any(@x: @y > 5)"
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "Issue: Undeclared variable inside nested object fails",
      "transformer": {
        "outer": {
          "inner": "@x"
        }
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "Issue: Undeclared source variable in using alias fails",
      "transformer": {
        "#using(@undeclared as @x) into 'result'": [
          "#setAt(@x.field, 5)"
        ]
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "Issue: Unknown method name causes a syntax error",
      "transformer": {
        "result": "#thisMethodDoesNotExist($.path)"
      },
      "expectedIssues": [
        "UnableToFindMethodImplementation"
      ]
    },
    {
      "name": "Issue: Property value only method used in property name fails",
      "transformer": {
        "#exists($.path)": "someValue"
      },
      "expectedIssues": [
        "UnableToUseMethodWithinPropertyName"
      ]
    },
    {
      "name": "Issue: Property name only method used in property value fails",
      "transformer": {
        "@x": "1",
        "result": "#nameOf(@x)"
      },
      "expectedIssues": [
        "UnableToUseMethodWithinPropertyValue"
      ]
    },
    {
      "name": "Property value only method nested in a property name method will succeed",
      "transformer": {
        "#includeIf(#exists($.path)) into 'result'": {
          "value": 1
        }
      },
      "expectedIssues": []
    },
    {
      "name": "Property value only method in a lambda nested in a property name method will succeed",
      "transformer": {
        "#includeIf(#any($.someArray, @x: #exists(@x))) into 'result'": {
          "value": 1
        }
      },
      "expectedIssues": []
    },
    {
      "name": "Issue: Property name only method nested in a property name method fails",
      "transformer": {
        "@x": "1",
        "#includeIf(#nameOf(@x)) into 'result'": {
          "value": 1
        }
      },
      "expectedIssues": [
        "UnableToUseMethodWithinPropertyValue"
      ]
    },
    {
      "name": "Issue: Unsafe eval method usage fails",
      "transformer": {
        "result": "#eval('1 + 2 == 3')"
      },
      "expectedIssues": [
        "UnsafeMethodCallNotAllowed"
      ]
    },
    {
      "name": "Issue: Method called with too few arguments fails",
      "transformer": {
        "result": "#valueOf()"
      },
      "expectedIssues": [
        "MissingRequiredMethodParameter"
      ]
    },
    {
      "name": "Issue: Method called with too many arguments fails",
      "transformer": {
        "result": "#currentDateTime('extra')"
      },
      "expectedIssues": [
        "MethodCallActualParameterCountExceedsFormalParameterCount"
      ]
    },
    {
      "name": "Issue: Multiple undeclared variables in one expression each produce an issue",
      "transformer": {
        "result": "@x + @y"
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable",
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "Two-variable lambda declares both variables in its body",
      "transformer": {
        "total": "#reduce($.values, @acc;@current: @acc + @current)",
        "pairs": "#zip($.first, $.second, @x;@y: @x + @y)"
      },
      "expectedIssues": []
    },
    {
      "name": "Issue: Two-variable lambda variables are not in scope outside of its body",
      "transformer": {
        "total": "#reduce($.values, @acc;@current: @acc) + @current"
      },
      "expectedIssues": [
        "AttemptedToUseUndeclaredVariable"
      ]
    },
    {
      "name": "Transform with a registered transformer will succeed",
      "registeredTransformers": [ "address" ],
      "transformer": {
        "result": "#transformWith($.path, 'address')"
      },
      "expectedIssues": []
    },
    {
      "name": "Transform with a transformer name that is not a literal is not checked",
      "transformer": {
        "result": "#transformWith($.path, $.transformerName)"
      },
      "expectedIssues": []
    },
    {
      "name": "Issue: Transform with an unregistered transformer fails",
      "registeredTransformers": [ "address" ],
      "transformer": {
        "result": "#transformWith($.path, 'person')"
      },
      "expectedIssues": [
        "UnableToLocateReferencedTransformer"
      ]
    },
    {
      "name": "Generated names in property names are complete expressions",
      "transformer": {
        "#foreach(@x in $.items) into 'result'": [ { "value": "@x" } ],
        "#foreach(@x in $.items) into @items": [ { "value": "@x" } ],
        "copy": "@items"
      },
      "expectedIssues": []
    },
    {
      "name": "Issue: Repeated closing parenthesis fails",
      "transformer": {
        "result": "#valueOf($.path))"
      },
      "expectedIssues": [
        "UnexpectedContentAfterExpression"
      ]
    },
    {
      "name": "Issue: Expression followed by another without an operator fails",
      "transformer": {
        "result": "#valueOf($.path) #valueOf($.other)"
      },
      "expectedIssues": [
        "UnexpectedContentAfterExpression"
      ]
    },
    {
      "name": "Issue: Operator without a right side fails",
      "transformer": {
        "result": "(#valueOf($.path) == )"
      },
      "expectedIssues": [
        "ExpectedExpressionAfterOperator"
      ]
    },
    {
      "name": "Issue: Operator at the end of an expression fails",
      "transformer": {
        "result": "#valueOf($.path) +"
      },
      "expectedIssues": [
        "ExpectedExpressionAfterOperator"
      ]
    },
    {
      "name": "Issue: Unterminated string literal fails",
      "transformer": {
        "result": "#valueOf('path)"
      },
      "expectedIssues": [
        "ExpectedTokenButFoundEndOfExpression"
      ]
    },
    {
      "name": "Statements with property value expressions as their values and conditions will succeed",
      "transformer": {
        "@outer": "#valueOf($.path)",
        "#using($.someObject as @x) into 'result'": [
          "#setAt(@x.first, @outer)",
          "#setAt(@x.second, @x.first)",
          "#setAt(@x.third, #valueOf($.path) + 1)",
          "#setAt(@x.fourth, @x.first->#toString())",
          "#setAt(@x.fifth, #if(@x.first == 1, @x.second, @outer))",
          "#setAt(@x.sixth, @x)",
          "#when(@x.first, #removeAt(@x.second))",
          "#when(#exists(@x.first), #when(@outer, #setAt(@x.second, 1), #removeAt(@x.third)))",
          "(#removeAt(@x.first))",
          "#when(!@x.first, (#removeAt(@x.second)))"
        ]
      },
      "expectedIssues": []
    },
    {
      "name": "Statement within a nested #foreach's using block will succeed",
      "transformer": {
        "#foreach(@item in $.someArray) into 'result'": [
          {
            "#using(@item as @x) into 'value'": [
              "#setAt(@x.field, @item.other)"
            ]
          }
        ]
      },
      "expectedIssues": []
    },
    {
      "name": "Issue: Non-statement method as a using entry fails",
      "transformer": {
        "#using($.someObject as @x) into 'result'": [ "#valueOf($.path)" ]
      },
      "expectedIssues": [
        "UnableToUseMethodWithinStatementBlock"
      ]
    },
    {
      "name": "Issue: Variable as a using entry fails",
      "transformer": {
        "#using($.someObject as @x) into 'result'": [ "@x.field" ]
      },
      "expectedIssues": [
        "UnableToUseNonStatementExpressionWithinStatementBlock"
      ]
    },
    {
      "name": "Issue: Parenthesized non-statement as a using entry fails",
      "transformer": {
        "#using($.someObject as @x) into 'result'": [ "(1 + 2)" ]
      },
      "expectedIssues": [
        "UnableToUseNonStatementExpressionWithinStatementBlock"
      ]
    },
    {
      "name": "Issue: Non-expression using entries fail",
      "transformer": {
        "#using($.someObject as @x) into 'result'": [ "text", 5, true, null, { "property": "#setAt(@x.field, 5)" }, [ "#setAt(@x.field, 5)" ] ]
      },
      "expectedIssues": [
        "UnableToUseNonStatementExpressionWithinStatementBlock",
        "UnableToUseNonStatementExpressionWithinStatementBlock",
        "UnableToUseNonStatementExpressionWithinStatementBlock",
        "UnableToUseNonStatementExpressionWithinStatementBlock",
        "UnableToUseNonStatementExpressionWithinStatementBlock",
        "UnableToUseNonStatementExpressionWithinStatementBlock"
      ]
    },
    {
      "name": "Issue: Using block that isn't an array fails",
      "transformer": {
        "#using($.someObject as @x) into 'result'": "#setAt(@x.field, 5)"
      },
      "expectedIssues": [
        "UnableToPerformUsingLibraryCallOnNonArrayToken"
      ]
    },
    {
      "name": "Issue: Piping into statements fails",
      "transformer": {
        "#using($.someObject as @x) into 'result'": [
          "@x.field->#removeAt()",
          "@x.field?->#setAt(5)",
          "#when(@x.field, @x.other->#removeAt())"
        ]
      },
      "expectedIssues": [
        "UnableToPipeIntoStatementMethod",
        "UnableToPipeIntoStatementMethod",
        "UnableToPipeIntoStatementMethod"
      ]
    },
    {
      "name": "Issue: Paths that aren't a dereference of the using variable fail",
      "transformer": {
        "@outer": "#valueOf($.path)",
        "#using($.someObject as @x) into 'result'": [
          "#removeAt(@x)",
          "#removeAt(#valueOf($.path))",
          "#setAt(@outer, 5)",
          "#setAt($.path, 5)",
          "#setAt('field', 5)",
          "#setAt(@x?.field, 5)"
        ]
      },
      "expectedIssues": [
        "UnableToUseStatementPathThatIsNotDereferenceOfUsingVariable",
        "UnableToUseStatementPathThatIsNotDereferenceOfUsingVariable",
        "UnableToUseStatementPathThatIsNotDereferenceOfUsingVariable",
        "UnableToUseStatementPathThatIsNotDereferenceOfUsingVariable",
        "UnableToUseStatementPathThatIsNotDereferenceOfUsingVariable",
        "UnableToUseStatementPathThatIsNotDereferenceOfUsingVariable"
      ]
    },
    {
      "name": "Issue: Dereference of a variable outside of the using block as a path fails",
      "transformer": {
        "@outer": "#valueOf($.path)",
        "#using($.someObject as @x) into 'result'": [ "#when(false, #setAt(@outer.field, 5))" ]
      },
      "expectedIssues": [
        "AttemptedToIndirectlyModifyVariableWithinUsingBlock"
      ]
    },
    {
      "name": "Issue: Non-statements given to #when fail",
      "transformer": {
        "#using($.someObject as @x) into 'result'": [
          "#when(false, #valueOf($.path))",
          "#when(false, @x)",
          "#when(false, 1)",
          "#when(false)"
        ]
      },
      "expectedIssues": [
        "AttemptedToUseNonStatementMethodWithinWhenLibraryCall",
        "AttemptedToUseNonMethodExpressionWithinWhenLibraryCall",
        "AttemptedToUseNonMethodExpressionWithinWhenLibraryCall",
        "UnableToUseStatementMethodWithoutStatements"
      ]
    },
    {
      "name": "Issue: Statements nested within statement parameters fail",
      "transformer": {
        "#using($.someObject as @x) into 'result'": [
          "#setAt(@x.first, #removeAt(@x.second))",
          "#when(#removeAt(@x.first), #removeAt(@x.second))",
          "#setAt(@x.first, #if(true, #removeAt(@x.second), 0))",
          "#setAt(@x.first, { 'property': #removeAt(@x.second) })",
          "#setAt(@x.first, @x.second ?? #removeAt(@x.third))",
          "#setAt(@x.first, #valueOf($.someArray)->#select(@n: #setAt(@n.value, 1)))"
        ]
      },
      "expectedIssues": [
        "UnableToUseMethodWithinNonRootStatementBlock",
        "UnableToUseMethodWithinNonRootStatementBlock",
        "UnableToUseMethodWithinNonRootStatementBlock",
        "UnableToUseMethodWithinNonRootStatementBlock",
        "UnableToUseMethodWithinNonRootStatementBlock",
        "UnableToUseMethodWithinNonRootStatementBlock"
      ]
    },
    {
      "name": "Issue: Statements outside of a using block fail",
      "transformer": {
        "@outer": "#valueOf($.path)",
        "first": "#setAt(@outer.field, 5)",
        "second": "#removeAt(@outer.field)",
        "third": "#when(true, #removeAt(@outer.field))",
        "fourth": "#if(true, #removeAt(@outer.field), 0)",
        "fifth": "@outer ?? #removeAt(@outer.field)",
        "sixth": "{ 'property': #removeAt(@outer.field) }",
        "seventh": [ "#removeAt(@outer.field)" ],
        "#includeIf(#if(true, #removeAt(@outer.field), false)) into 'eighth'": { "value": 1 }
      },
      "expectedIssues": [
        "UnableToUseMethodOutsideOfStatementBlock",
        "UnableToUseMethodOutsideOfStatementBlock",
        "UnableToUseMethodOutsideOfStatementBlock",
        "UnableToUseMethodOutsideOfStatementBlock",
        "UnableToUseMethodOutsideOfStatementBlock",
        "UnableToUseMethodOutsideOfStatementBlock",
        "UnableToUseMethodOutsideOfStatementBlock",
        "UnableToUseMethodOutsideOfStatementBlock"
      ]
    }
  ]
}
