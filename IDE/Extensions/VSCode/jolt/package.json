{
  "name": "jolt",
  "displayName": "Jolt Language",
  "description": "A friendly way of transforming JSON into different JSON.",
  "version": "1.6.0",
  "icon": "./JoltLogo.png",
  "publisher": "Norhaven",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Norhaven/Jolt",
  "bugs": {
    "url": "https://github.com/Norhaven/Jolt/issues"
  },
  "keywords": [
    "jolt",
    "json",
    "transform",
    "transformation",
    "transformer",
    "syntax",
    "highlighting",
    "completion",
    "language"
  ],
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "directory": "IDE/Extensions/VSCode/jolt",
    "url": "https://github.com/Norhaven/Jolt"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Custom methods and transformers from .jolt/methods.json files are only used in trusted workspaces. Syntax coloring, standard library completions, hover, and validation work everywhere."
    }
  },
  "extensionDependencies": [
    "ms-dotnettools.vscode-dotnet-runtime"
  ],
  "scripts": {
    "vscode:prepublish": "npm run build-metadata && npm run build-server && npm run package",
    "build-metadata": "dotnet run --project ../../../Tools/Jolt.LanguageMetadata -c Release -- --output src/data/library-methods.json",
    "check-metadata": "dotnet run --project ../../../Tools/Jolt.LanguageMetadata -c Release -- --output src/data/library-methods.json --check",
    "build-server": "dotnet publish ../../../LanguageServer/Jolt.LanguageServer -c Release -o server --nologo",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run check-types && node esbuild.mjs --production",
    "check-types": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/**/*.test.js\"",
    "test:integration": "npm run compile && tsc -p integration && vscode-test",
    "test:e2e": "npm run compile && playwright test"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.101.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "ovsx": "^1.2.0",
    "typescript": "^6.0.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "jolt.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Jolt"
      },
      {
        "command": "jolt.showLanguageServerOutput",
        "title": "Show Language Server Output",
        "category": "Jolt"
      },
      {
        "command": "jolt.openPreview",
        "title": "Open Preview to the Side",
        "category": "Jolt",
        "icon": "$(open-preview)"
      },
      {
        "command": "jolt.choosePreviewInput",
        "title": "Choose Preview Input",
        "category": "Jolt",
        "icon": "$(list-selection)"
      },
      {
        "command": "jolt.openPreviewInput",
        "title": "Open Preview Input File",
        "category": "Jolt",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "jolt.openPreview",
          "when": "resourceLangId == jolt && resourceScheme != jolt-preview",
          "group": "navigation"
        },
        {
          "command": "jolt.choosePreviewInput",
          "when": "resourceScheme == jolt-preview",
          "group": "navigation@1"
        },
        {
          "command": "jolt.openPreviewInput",
          "when": "resourceScheme == jolt-preview",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "jolt.openPreview",
          "when": "editorLangId == jolt || resourceScheme == jolt-preview"
        },
        {
          "command": "jolt.choosePreviewInput",
          "when": "editorLangId == jolt || resourceScheme == jolt-preview"
        },
        {
          "command": "jolt.openPreviewInput",
          "when": "editorLangId == jolt || resourceScheme == jolt-preview"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+space",
        "command": "runCommands",
        "args": {
          "commands": [
            "editor.action.triggerSuggest",
            "editor.action.triggerParameterHints"
          ]
        },
        "when": "editorTextFocus && editorLangId == jolt && !editorReadonly && !suggestWidgetVisible"
      }
    ],
    "configuration": {
      "title": "Jolt",
      "properties": {
        "jolt.completion.includeUnsafeMethods": {
          "type": "boolean",
          "default": false,
          "description": "Include library methods marked as unsafe (such as #eval) in completions. These methods only work when the host application explicitly enables them."
        },
        "jolt.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Validate transformers with the Jolt library as you edit them. This runs the Jolt language server, which needs .NET 8 or later and installs it through the .NET Install Tool when none is found."
        },
        "jolt.validation.allowUnsafeMethods": {
          "type": "boolean",
          "default": false,
          "description": "Don't report the use of unsafe library methods (such as #eval) when the host application explicitly enables them."
        }
      }
    },
    "languages": [
      {
        "id": "jolt",
        "aliases": [
          "Jolt",
          "jolt"
        ],
        "extensions": [
          ".jolt.json"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jolt",
        "scopeName": "source.jolt",
        "path": "./syntaxes/jolt.tmLanguage.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/.jolt/methods.json",
        "url": "./schemas/jolt-methods.schema.json"
      },
      {
        "fileMatch": "**/.jolt/*/*.input.json",
        "url": "./schemas/jolt-preview-input.schema.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "[Dark 2026][Dark Modern][Dark+][Default Dark Modern][Default Dark+][Visual Studio Dark]": {
          "textMateRules": [
            {
              "scope": [
                "keyword.control.jolt",
                "keyword.control.jolt punctuation.definition.function.jolt"
              ],
              "settings": {
                "foreground": "#C586C0"
              }
            },
            {
              "scope": [
                "keyword.other.jolt"
              ],
              "settings": {
                "foreground": "#4EC9B0"
              }
            },
            {
              "scope": [
                "constant.language.jolt",
                "variable.language.root.jolt",
                "variable.language.params.jolt",
                "variable.language.params.jolt punctuation.definition.variable.jolt"
              ],
              "settings": {
                "foreground": "#7eb1da"
              }
            },
            {
              "scope": [
                "support.function.builtin.jolt",
                "entity.name.function.jolt",
                "keyword.other.statement.jolt",
                "support.function.builtin.jolt punctuation.definition.function.jolt",
                "entity.name.function.jolt punctuation.definition.function.jolt",
                "keyword.other.statement.jolt punctuation.definition.function.jolt"
              ],
              "settings": {
                "foreground": "#DCDCAA"
              }
            },
            {
              "scope": [
                "variable.other.jolt",
                "variable.other.declaration.jolt",
                "variable.parameter.jolt",
                "variable.other.property.jolt",
                "variable.language.discard.jolt",
                "variable.other.jolt punctuation.definition.variable.jolt",
                "variable.other.declaration.jolt punctuation.definition.variable.jolt",
                "variable.parameter.jolt punctuation.definition.variable.jolt"
              ],
              "settings": {
                "foreground": "#7ba5dd"
              }
            },
            {
              "scope": [
                "support.type.property-name.jolt",
                "punctuation.support.type.property-name.begin.jolt",
                "punctuation.support.type.property-name.end.jolt"
              ],
              "settings": {
                "foreground": "#a9cddf"
              }
            },
            {
              "scope": [
                "string.quoted.single.jolt",
                "string.quoted.double.jolt",
                "punctuation.definition.string.begin.jolt",
                "punctuation.definition.string.end.jolt"
              ],
              "settings": {
                "foreground": "#CE9178"
              }
            },
            {
              "scope": [
                "constant.character.escape.jolt"
              ],
              "settings": {
                "foreground": "#D7BA7D"
              }
            },
            {
              "scope": [
                "constant.numeric.jolt"
              ],
              "settings": {
                "foreground": "#B5CEA8"
              }
            },
            {
              "scope": [
                "keyword.operator.pipe.jolt",
                "keyword.operator.null-coalescing.jolt",
                "keyword.operator.logical.jolt",
                "keyword.operator.comparison.jolt",
                "keyword.operator.relational.jolt",
                "keyword.operator.arithmetic.jolt",
                "keyword.operator.range.jolt",
                "storage.type.function.lambda.jolt",
                "constant.language.wildcard.jolt",
                "punctuation.accessor.jolt",
                "punctuation.accessor.recursive.jolt"
              ],
              "settings": {
                "foreground": "#D4D4D4"
              }
            }
          ]
        },
        "[Light 2026][Light Modern][Light+][Default Light Modern][Default Light+][Visual Studio Light]": {
          "textMateRules": [
            {
              "scope": [
                "keyword.control.jolt",
                "keyword.control.jolt punctuation.definition.function.jolt"
              ],
              "settings": {
                "foreground": "#AF00DB"
              }
            },
            {
              "scope": [
                "keyword.other.jolt"
              ],
              "settings": {
                "foreground": "#267F99"
              }
            },
            {
              "scope": [
                "constant.language.jolt",
                "variable.language.root.jolt",
                "variable.language.params.jolt",
                "variable.language.params.jolt punctuation.definition.variable.jolt"
              ],
              "settings": {
                "foreground": "#0000FF"
              }
            },
            {
              "scope": [
                "support.function.builtin.jolt",
                "entity.name.function.jolt",
                "keyword.other.statement.jolt",
                "support.function.builtin.jolt punctuation.definition.function.jolt",
                "entity.name.function.jolt punctuation.definition.function.jolt",
                "keyword.other.statement.jolt punctuation.definition.function.jolt"
              ],
              "settings": {
                "foreground": "#795E26"
              }
            },
            {
              "scope": [
                "variable.other.jolt",
                "variable.other.declaration.jolt",
                "variable.parameter.jolt",
                "variable.other.property.jolt",
                "variable.language.discard.jolt",
                "variable.other.jolt punctuation.definition.variable.jolt",
                "variable.other.declaration.jolt punctuation.definition.variable.jolt",
                "variable.parameter.jolt punctuation.definition.variable.jolt"
              ],
              "settings": {
                "foreground": "#001080"
              }
            },
            {
              "scope": [
                "support.type.property-name.jolt",
                "punctuation.support.type.property-name.begin.jolt",
                "punctuation.support.type.property-name.end.jolt"
              ],
              "settings": {
                "foreground": "#0451A5"
              }
            },
            {
              "scope": [
                "string.quoted.single.jolt",
                "string.quoted.double.jolt",
                "punctuation.definition.string.begin.jolt",
                "punctuation.definition.string.end.jolt"
              ],
              "settings": {
                "foreground": "#A31515"
              }
            },
            {
              "scope": [
                "constant.character.escape.jolt"
              ],
              "settings": {
                "foreground": "#EE0000"
              }
            },
            {
              "scope": [
                "constant.numeric.jolt"
              ],
              "settings": {
                "foreground": "#098658"
              }
            },
            {
              "scope": [
                "keyword.operator.pipe.jolt",
                "keyword.operator.null-coalescing.jolt",
                "keyword.operator.logical.jolt",
                "keyword.operator.comparison.jolt",
                "keyword.operator.relational.jolt",
                "keyword.operator.arithmetic.jolt",
                "keyword.operator.range.jolt",
                "storage.type.function.lambda.jolt",
                "constant.language.wildcard.jolt",
                "punctuation.accessor.jolt",
                "punctuation.accessor.recursive.jolt"
              ],
              "settings": {
                "foreground": "#000000"
              }
            }
          ]
        },
        "textMateRules": [
          {
            "scope": [
              "support.function.unsafe.jolt",
              "support.function.unsafe.jolt punctuation.definition.function.jolt"
            ],
            "settings": {
              "fontStyle": "underline"
            }
          }
        ]
      }
    }
  }
}
