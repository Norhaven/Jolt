{
	"version": "2.0.0",
	"tasks": [
		{
			// Opens an Extension Development Host window with its extension host inspector on a fixed port, so that the
			// "Attach to Extension Host" configuration can connect over 127.0.0.1 rather than resolving localhost.
			// The code CLI returns as soon as the window is requested, so this task completes immediately.
			"label": "Open Extension Development Host",
			"type": "shell",
			"command": "code",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--inspect-extensions=9333"
			],
			"dependsOn": "npm: compile",
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent"
			}
		},
		{
			// Rebuilds everything the extension is built from, in order: Jolt and its library method list (which the
			// metadata tool reads from the built library), the language server published into ./server, the extension,
			// and the latest Jolt.Testing JSON test files copied into ./tests.
			"label": "Build Extension With Latest Jolt",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Build Library Method Metadata",
				"Build Language Server",
				"Build Extension",
				"Copy Test Files"
			],
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Build Library Method Metadata",
			"type": "npm",
			"script": "build-metadata",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build Language Server",
			"type": "npm",
			"script": "build-server",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build Extension",
			"type": "npm",
			"script": "compile",
			"problemMatcher": "$tsc"
		},
		{
			"label": "Copy Test Files",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/CopyTestFiles.ps1"
			],
			"problemMatcher": []
		}
	]
}
